# Template rendered by deploy.sh; @PLACEHOLDERS@ are filled in for the target server.
[Unit]
Description=Arcus spot volume bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@USER@
Group=@GROUP@
WorkingDirectory=@APP_DIR@
# Day boundaries and ACTIVE_HOURS use this time zone, regardless of the server's own.
Environment=TZ=@TZ@
Environment=NODE_ENV=production
# systemd does not load nvm or shell profiles, so Node is referenced by absolute path.
Environment=PATH=@NODE_DIR@:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=@NODE_DIR@/node @APP_DIR@/node_modules/tsx/dist/cli.mjs --env-file=.env src/volume-bot.ts

# `systemctl stop` sends SIGTERM: the bot finishes any open buy+sell pair, then exits.
KillSignal=SIGTERM
TimeoutStopSec=180
# Restart after crashes; a clean exit (every wallet hit its stop condition) stays stopped.
Restart=on-failure
RestartSec=30

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=@PROTECT_HOME@
ReadWritePaths=@APP_DIR@/logs

[Install]
WantedBy=multi-user.target
