# Private keys of the trading wallets on Robinhood Chain, comma-separated (0x-prefixed hex).
# Example: PRIVATE_KEYS=0xabc...,0xdef...  (deploy.sh prompts for them when empty)
PRIVATE_KEYS=

# Max slippage tolerance per swap in basis points (a ceiling, not a cost).
# 50 leaves room for normal price moves; too tight causes failed swaps, and
# 5 consecutive failures stop a wallet.
SLIPPAGE_BPS=50

# Stop a wallet once its USDG is this many dollars below its first-run balance.
MAX_LOSS_USD=20
# Stop a wallet when its USDG balance drops below this size.
MIN_TRADE_USD=10

# One trade = buy with all USDG + immediate sell back (~$0.079 each on a ~$30 wallet).
# Random number of trades per wallet per local day, rolled once per day;
# ~18 trades/day burns about $20 over 14 days.
DAILY_TRADES_MIN=14
DAILY_TRADES_MAX=22

# Local hours in which trades happen; the day's trades are spread across this window.
# The systemd unit sets TZ=Asia/Ho_Chi_Minh (override with BOT_TZ when running deploy.sh).
ACTIVE_HOURS_START=8
ACTIVE_HOURS_END=23

# Bounds for the random gap between trades, re-rolled after every trade.
DELAY_SEC_MIN=300
DELAY_SEC_MAX=5400

# Optional dedicated RPC endpoint; empty uses the public Robinhood Chain RPC.
RPC_URL=
