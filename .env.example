# Private keys of the trading wallets on Robinhood Chain, comma-separated (0x-prefixed hex).
# A single PRIVATE_KEY=0x... also works. Never commit .env.
PRIVATE_KEYS=0xkey1,0xkey2
# Max slippage tolerance per swap in basis points (a ceiling, not a cost).
SLIPPAGE_BPS=50
# Stop a wallet once its USDG is this many dollars below its first-run balance.
MAX_LOSS_USD=20
# Stop a wallet when its USDG balance drops below this size.
MIN_TRADE_USD=10
# One trade = buy with all USDG + immediate sell back.
# Random number of trades per wallet per local day, rolled once per day.
# Defaults (~18/day at ~$0.079 each) burn about $20 over 14 days from a ~$30 wallet.
DAILY_TRADES_MIN=14
DAILY_TRADES_MAX=22
# Local hours in which trades happen; the day's trades are spread across this window.
ACTIVE_HOURS_START=8
ACTIVE_HOURS_END=23
# Bounds for the random gap between trades, re-rolled after every trade.
DELAY_SEC_MIN=300
DELAY_SEC_MAX=5400
# Optional: dedicated RPC endpoint; defaults to the public Robinhood Chain RPC.
RPC_URL=
